TWELVE_DATA_API_KEY_1=your_key_here
TWELVE_DATA_API_KEY_2=your_key_here
TWELVE_DATA_API_KEY_3=your_key_here
TWELVE_DATA_API_KEY_4=your_key_here
TWELVE_DATA_API_KEY_5=your_key_here

# Supabase (leave blank to disable; CSV/JSONL still written)
# Settings > API
SUPABASE_DB_URL=https://your-project-ref.supabase.co
SUPABASE_DB_KEY=your_service_role_key_here

# Settings > Database > Connection string > URI
# Used only at startup to auto-create tables (psycopg2).
SUPABASE_DB_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
